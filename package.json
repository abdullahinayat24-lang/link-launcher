{
  "name": "dreamslab-cyber-launcher",
  "productName": "DreamsLab Cyber Launcher",
  "version": "1.0.9",
  "description": "Futuristic Glass Chrome Link Launcher by DreamsLabStudio",
  "main": "main.js",
  "scripts": {
    "start": "node main.js",
    "desktop": "electron .",
    "start:server": "node server/server.js",
    "package:win": "electron-packager . \"DreamsLab Cyber Launcher\" --platform=win32 --arch=x64 --out=dist --overwrite",
    "package:installer": "electron-builder --win nsis --publish never",
    "test": "node tests/run-all.js"
  },
  "keywords": [
    "launcher",
    "chrome",
    "cyber",
    "glassmorphic"
  ],
  "author": "DreamsLabStudio",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.1",
    "electron": "^40.8.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.dreamslabstudio.linklauncher",
    "productName": "DreamsLab Cyber Launcher",
    "artifactName": "DreamsLab-Cyber-Launcher-Setup-${version}.${ext}",
    "asar": true,
    "directories": {
      "output": "dist_installer"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DreamsLab Cyber Launcher",
      "runAfterFinish": true,
      "uninstallDisplayName": "DreamsLab Cyber Launcher"
    }
  }
}
